<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>English Word Search</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#101522;
  color:white;
  padding:20px 10px;
  text-align:center;
}
h1{margin:5px 0 8px}
p{color:#bfc7d5}
#board{
  width:min(92vw,620px);
  margin:20px auto;
  display:grid;
  grid-template-columns:repeat(18,minmax(0,1fr));
  gap:2px;
  touch-action:none;
  user-select:none;
}
.cell{
  aspect-ratio:1;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#202a3b;
  border-radius:4px;
  font-weight:bold;
  font-size:clamp(10px,3vw,20px);
  cursor:pointer;
}
.cell.selected{background:#3978d8}
.cell.found{background:#22a866}
#words{
  width:min(95vw,750px);
  margin:20px auto;
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:8px;
}
.word{
  background:#202a3b;
  padding:7px 10px;
  border-radius:8px;
  font-size:14px;
}
.word.done{
  background:#174d36;
  text-decoration:line-through;
  color:#8ff0bb;
}
button{
  border:0;
  border-radius:10px;
  padding:12px 20px;
  font-size:16px;
  background:#3978d8;
  color:white;
}
@media(max-width:500px){
  body{padding:12px 5px}
  #board{gap:1px}
  .cell{border-radius:2px}
  .word{font-size:12px;padding:6px 8px}
}
</style>
</head>

<body>

<h1>🔎 English Word Search</h1>
<p>Find all the words. Drag from the first letter to the last.</p>

<div id="board"></div>

<h2>Words to find:</h2>
<div id="words"></div>

<button onclick="startGame()">🔄 New Game</button>

